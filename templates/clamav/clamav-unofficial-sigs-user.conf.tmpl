# Overrides clamav-unofficial-sigs dla NASZEJ instalacji ClamAV.
# user.conf jest wczytywany na końcu (nadpisuje master.conf/os.conf) — wystarczą
# tu tylko zmieniane wartości. Pobierani są DARMOWI providerzy (SaneSecurity,
# URLhaus, LinuxMalwareDetect, interServer, foxhole/winnow) — securiteinfo i
# malwarepatrol wymagają płatnych kluczy i pozostają nieaktywni (brak kluczy).

# Nasz clamd działa jako clamscan (nie domyślny clamupdate), bazy w /var/lib/clamav,
# gniazdo skanu jak w scan.conf.
clam_user="clamscan"
clam_group="clamscan"
clamav_dbs="/var/lib/clamav"
clamd_socket="/run/clamd.scan/clamd.sock"

# Po pobraniu nowych sygnatur przeładuj clamd (żeby od razu obowiązywały).
reload_dbs="yes"

# Bramka bezpieczeństwa narzędzia — bez tego skrypt odmawia działania.
# U nas konfiguracją zarządza ten szablon, więc jawnie potwierdzamy.
user_configuration_complete="yes"

# --- Pobieranie po HTTP zamiast rsync -----------------------------------------
# rsync (port TCP 873) bywa ZABLOKOWANY na wychodzącym ruchu w wielu sieciach
# (firmowych/chmurowych) — wtedy wszystkie mirrory SaneSecurity padają na
# połączeniu. HTTP(S) prawie zawsze przechodzi. `force_wget` przełącza pobieranie
# na wget/curl. WYMAGA wget (Rocky Minimal go nie ma — instaluje go
# scripts/vm2/42-sanesecurity.sh; curl jest z pakietów bazowych).
force_wget="yes"
wget_bin="/usr/bin/wget"
curl_bin="/usr/bin/curl"

# Bez losowej pauzy startowej narzędzia (60–600 s) — chcemy przewidywalny,
# szybki przebieg (i żeby timeout w skrypcie nie ciął go w środku pauzy).
enable_random="no"

# Krótsze timeouty — przy problemach z mirrorem szybciej odpuszcza zamiast wisieć.
downloader_connect_timeout="15"
downloader_max_time="300"
downloader_tries="3"
rsync_connect_timeout="15"
rsync_max_time="300"

# SaneSecurity w tym narzędziu pobiera się WYŁĄCZNIE przez rsync (na sztywno
# rsync://) — na sieciach blokujących port 873 zawsze pada. Dlatego wyłączamy je
# TU, a pobieramy osobnym skryptem po HTTPS z weryfikacją GPG
# (vm2-sanesecurity-http.sh + timer). URLhaus/interServer/LinuxMalwareDetect mają
# URL-e https i dalej idą przez to narzędzie (force_wget).
enable_sanesecurity="no"
